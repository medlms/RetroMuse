<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Album artwork, falling back to the launcher icon -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="Album artwork" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RetroMuse"
            android:textColor="#FF171214"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a song to start"
            android:textColor="#FF938A8F"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_btn_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="Previous"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/widget_btn_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="9dp"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="Play or pause"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/widget_btn_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_next"
        android:contentDescription="Next"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
