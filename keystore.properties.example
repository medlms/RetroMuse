# Copy to keystore.properties (which is git-ignored) and fill in real values.
# Without this file the app still builds and runs; release signing and live ads are
# simply skipped, and AdMob falls back to Google's test units.

storeFile=release-key.jks
storePassword=CHANGE_ME
keyAlias=retromuse
keyPassword=CHANGE_ME

# AdMob - leave unset to keep Google's official test IDs.
admobAppId=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
admobBannerUnitId=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
